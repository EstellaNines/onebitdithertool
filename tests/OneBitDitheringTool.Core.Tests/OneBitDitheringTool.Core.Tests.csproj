<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xunit v3 的测试项目本身是可执行程序 -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>OneBitDitheringTool.Core.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <!-- 钉在 3.2.2：Avalonia.Headless.XUnit 12.1.3 按此版本编译，后续界面测试要与之兼容 -->
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <!-- 仅用于测试：独立于 Core 解码 PNG，用来校验 Core 自写的 PNG 编码器与 didder 的输出 -->
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- 测试文件免写 using Xunit -->
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OneBitDitheringTool.Core\OneBitDitheringTool.Core.csproj" />
  </ItemGroup>

</Project>
