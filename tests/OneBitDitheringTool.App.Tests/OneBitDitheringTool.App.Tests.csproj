<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xunit v3 的测试项目本身是可执行程序 -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>OneBitDitheringTool.App.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <!-- 与 Core.Tests 一致，钉在 3.2.2，Avalonia.Headless.XUnit 12.1.3 按此版本编译 -->
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <!-- 无头渲染：不需要真实窗口与显示器，就能创建控件、模拟输入并截取渲染结果 -->
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OneBitDitheringTool.App\OneBitDitheringTool.App.csproj" />
  </ItemGroup>

</Project>
