<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OneBitDitheringTool.App.App"
             RequestedThemeVariant="Dark">
  <!-- 与原版一致使用深色主题：黑白成品在深灰底上更易分辨 -->
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
</Application>
