<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:OneBitDitheringTool.App.Controls"
        x:Class="OneBitDitheringTool.App.MainWindow"
        Title="OneBitDitheringTool"
        Width="1280"
        Height="720"
        MinWidth="900"
        MinHeight="560"
        DragDrop.AllowDrop="True">

  <Window.Resources>
    <!-- 棋盘格底纹：让透明区域看得出来，也让黑白成品与背景有区分 -->
    <DrawingBrush x:Key="CheckerBrush" TileMode="Tile" DestinationRect="0,0,16,16">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#262626" Geometry="M0,0 H16 V16 H0 Z" />
          <GeometryDrawing Brush="#303030" Geometry="M0,0 H8 V8 H0 Z M8,8 H16 V16 H8 Z" />
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>
  </Window.Resources>

  <Grid ColumnDefinitions="*,320">

    <!-- 预览区 -->
    <!-- Focusable：点击预览区后焦点离开滑杆，左右方向键才能用来切图 -->
    <Border Name="PreviewHost"
            Background="{StaticResource CheckerBrush}"
            ClipToBounds="True"
            Focusable="True"
            PointerPressed="OnPreviewPointerPressed"
            PointerMoved="OnPreviewPointerMoved"
            PointerReleased="OnPreviewPointerReleased"
            PointerWheelChanged="OnPreviewWheelChanged">
      <Grid>
        <Canvas Name="PreviewCanvas">
          <!-- 缩放时按最近邻取样，像素边缘保持锐利，才看得清抖动图案 -->
          <Image Name="PreviewImage" Stretch="Fill" RenderOptions.BitmapInterpolationMode="None" />
        </Canvas>
        <StackPanel Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
          <Button Content="Open Image(s)..." HorizontalAlignment="Center" Click="OnOpenClick" />
          <TextBlock Text="or" HorizontalAlignment="Center" />
          <TextBlock Text="Drag image or folder into window" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 工具栏 -->
    <Border Grid.Column="1" Background="#1E1E1E" Padding="12">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,8,0,0">
          <CheckBox Name="ShowOriginalCheckBox" Content="Show Original" />
          <Button Name="SaveAllButton"
                  Content="Save All To Output Folder"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Height="50"
                  IsEnabled="False"
                  Click="OnSaveAllClick" />
          <TextBlock Name="StatusText" TextWrapping="Wrap" Opacity="0.8" />
        </StackPanel>

        <ScrollViewer>
          <StackPanel Spacing="10" Margin="0,0,8,0">

            <Button Name="OpenButton"
                    Content="Open Image(s)..."
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Height="40"
                    Click="OnOpenClick" />

            <StackPanel Spacing="2">
              <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Name="ImageCountText" Text="Image 0 of 0" VerticalAlignment="Center" />
                <Button Name="PreviousButton"
                        Grid.Column="1"
                        Content="&lt;"
                        Width="32"
                        IsEnabled="False"
                        Click="OnPreviousClick"
                        ToolTip.Tip="Previous image (Left arrow)" />
                <Button Name="NextButton"
                        Grid.Column="2"
                        Content="&gt;"
                        Width="32"
                        Margin="4,0,0,0"
                        IsEnabled="False"
                        Click="OnNextClick"
                        ToolTip.Tip="Next image (Right arrow)" />
              </Grid>
              <TextBlock Name="FileNameText" TextTrimming="CharacterEllipsis" Opacity="0.8" />
              <TextBlock Name="SizeText" Opacity="0.8" />
              <TextBlock Name="ZoomText" Text="Zoom: 1x" Opacity="0.8" ToolTip.Tip="Mouse wheel to zoom, drag to pan" />
            </StackPanel>

            <controls:ParameterSlider x:Name="ScaleSlider" Header="Scale" Minimum="0.01" Maximum="1" DefaultValue="1" Value="1" />

            <Border Height="1" Background="#3A3A3A" />

            <CheckBox Name="SplitChannelsCheckBox" Content="Split Channels" />
            <StackPanel Name="ChannelPanel" Spacing="6" IsVisible="False">
              <controls:ParameterSlider x:Name="RedSlider" Header="Red" Minimum="0" Maximum="1" DefaultValue="0.3" Value="0.3" />
              <controls:ParameterSlider x:Name="GreenSlider" Header="Green" Minimum="0" Maximum="1" DefaultValue="0.59" Value="0.59" />
              <controls:ParameterSlider x:Name="BlueSlider" Header="Blue" Minimum="0" Maximum="1" DefaultValue="0.11" Value="0.11" />
              <Button Content="Reset" Click="OnResetChannelsClick" />
            </StackPanel>

            <Border Height="1" Background="#3A3A3A" />

            <controls:ParameterSlider x:Name="StrengthSlider" Header="Strength" Minimum="-1" Maximum="1" DefaultValue="1" Value="1" />
            <controls:ParameterSlider x:Name="BrightnessSlider" Header="Brightness" Minimum="-1" Maximum="1" DefaultValue="0" Value="0" />
            <controls:ParameterSlider x:Name="ContrastSlider" Header="Contrast" Minimum="-1" Maximum="1" DefaultValue="0" Value="0" />

            <Border Height="1" Background="#3A3A3A" />

            <TextBlock Text="Dither Type" />
            <ComboBox Name="DitherTypeComboBox" HorizontalAlignment="Stretch" SelectedIndex="0">
              <ComboBoxItem Content="Bayer Matrix" />
              <ComboBoxItem Content="Ordered Dithering Matrix" />
              <ComboBoxItem Content="Error Diffusion Matrix" />
              <ComboBoxItem Content="Random" />
            </ComboBox>

            <StackPanel Name="BayerPanel" Spacing="6">
              <CheckBox Name="CustomBayerCheckBox" Content="Custom Bayer Size" />
              <ComboBox Name="BayerSizeComboBox" HorizontalAlignment="Stretch" />
              <StackPanel Name="CustomBayerPanel" Orientation="Horizontal" Spacing="8" IsVisible="False">
                <ComboBox Name="BayerWidthComboBox" Width="100" />
                <TextBlock Text="x" VerticalAlignment="Center" />
                <ComboBox Name="BayerHeightComboBox" Width="100" />
              </StackPanel>
            </StackPanel>

            <StackPanel Name="OrderedPanel" Spacing="6" IsVisible="False">
              <TextBlock Text="Ordered Dithering Matrix" />
              <ComboBox Name="OrderedMatrixComboBox" HorizontalAlignment="Stretch" />
            </StackPanel>

            <StackPanel Name="ErrorPanel" Spacing="6" IsVisible="False">
              <TextBlock Text="Error Diffusion Matrix" />
              <CheckBox Name="SerpentineCheckBox" Content="Use Serpentine" />
              <ComboBox Name="ErrorKernelComboBox" HorizontalAlignment="Stretch" />
            </StackPanel>

            <StackPanel Name="RandomPanel" Spacing="6" IsVisible="False">
              <controls:ParameterSlider x:Name="RandomMinSlider" Header="Random Min" Minimum="-2" Maximum="2" DefaultValue="-0.5" Value="-0.5" />
              <controls:ParameterSlider x:Name="RandomMaxSlider" Header="Random Max" Minimum="-2" Maximum="2" DefaultValue="0.5" Value="0.5" />
              <Button Content="Random Noise Range" Click="OnResetRandomClick" />
            </StackPanel>

          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</Window>
