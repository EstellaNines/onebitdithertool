<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe：Windows 上不弹控制台窗口；在 macOS 与 Linux 上与普通可执行程序无异 -->
    <OutputType>WinExe</OutputType>
    <RootNamespace>OneBitDitheringTool.App</RootNamespace>
    <AssemblyName>OneBitDitheringTool</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <!-- 直接用 Skia 解码图片以取得非预乘的 RGBA；版本须与 Avalonia.Skia 12.1.3 所依赖的一致 -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OneBitDitheringTool.Core\OneBitDitheringTool.Core.csproj" />
  </ItemGroup>

</Project>
